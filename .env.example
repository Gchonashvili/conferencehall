# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1
# DATABASE_URL=postgres://...neon.tech/neondb?sslmode=require

# Hosts hall photos may be served from (comma-separated, https only). A URL on
# any other host is rejected by the admin form and falls back to the placeholder
# illustration, because next/image refuses to render unlisted hosts.
# NEXT_PUBLIC_IMAGE_HOST=photos.example.com,cdn.example.com

# Phase 4
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# Phase 5
# PAYMENT_PROVIDER=flitt | payze
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
